# RV Fitness — Environment Configuration (MySQL Edition)
# Copy this file to backend/.env and fill in your values
# NEVER commit .env to version control

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ===========================================
# Database (MySQL 8.0+ / MariaDB)
# ===========================================
# Option 1: Docker Compose / XAMPP / MariaDB (root has empty password):
# DATABASE_URL="mysql://root:@localhost:3306/rvfitness_dev?connection_limit=10"
# DATABASE_URL_TEST="mysql://root:@localhost:3306/rvfitness_test?connection_limit=5"

# Option 2: Standard MySQL 8.0 installer (with a set root password):
DATABASE_URL="mysql://root:your_password@localhost:3306/rvfitness_dev?connection_limit=10"
DATABASE_URL_TEST="mysql://root:your_password@localhost:3306/rvfitness_test?connection_limit=5"

# ===========================================
# Authentication & QR Tokens
# ===========================================
JWT_SECRET=replace_with_a_secure_random_string_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
QR_TOKEN_HMAC_SECRET=replace_with_another_secure_random_hmac_secret

# ===========================================
# Initial Admin (used by seed-admin script only)
# ===========================================
ADMIN_EMAIL=admin@rvfitness.com
ADMIN_PASSWORD=change_this_immediately
ADMIN_NAME=RV Fitness Admin

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Financial & Billing Defaults
# ===========================================
DEFAULT_TAX_RATE_BPS=1800
INVOICE_PREFIX=RV-INV
PAYMENT_PREFIX=RV-PAY
RECEIPT_PREFIX=RV-REC
REFUND_PREFIX=RV-REF
EXPENSE_PREFIX=RV-EXP
MEMBER_CODE_PREFIX=RV-MEM
CURRENCY_CODE=INR

# ===========================================
# Membership & Operational Defaults
# ===========================================
OVERDUE_GRACE_DAYS=3
EXPIRY_WARNING_DAYS=30,15,7,3
MAX_FREEZE_DAYS_PER_YEAR=30

# ===========================================
# Gym Metadata & Narsobawadi Center
# ===========================================
GYM_NAME=RV Fitness
GYM_ADDRESS=Near Datta Mandir, Narsobawadi, Taluka Shirol, Kolhapur, Maharashtra 416104
GYM_PHONE=+91-9876543210
GYM_EMAIL=contact@rvfitness.in
GYM_GSTIN=27AABCR1234F1Z9
