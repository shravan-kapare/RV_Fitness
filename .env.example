# RV Fitness — Environment Configuration (MySQL Edition)
# Copy this file to backend/.env and fill in your values
# NEVER commit .env to version control

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ===========================================
# Database (MySQL 8.0+ / MariaDB)
# ===========================================
DATABASE_URL=mysql://root:password@localhost:3306/rvfitness_dev?connection_limit=10
DATABASE_URL_TEST=mysql://root:password@localhost:3306/rvfitness_test?connection_limit=5

# ===========================================
# Authentication (JWT)
# ===========================================
JWT_SECRET=replace_with_a_secure_random_string_at_least_64_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Initial Admin (used by seed-admin script only)
# ===========================================
ADMIN_EMAIL=admin@rvfitness.com
ADMIN_PASSWORD=change_this_immediately
ADMIN_NAME=RV Fitness Admin

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Financial & Billing Defaults
# ===========================================
DEFAULT_TAX_RATE_BPS=1800
INVOICE_PREFIX=INV
PAYMENT_PREFIX=PAY
RECEIPT_PREFIX=RCT
CURRENCY_CODE=INR

# ===========================================
# Gym Metadata
# ===========================================
GYM_NAME=RV Fitness
GYM_ADDRESS=Narsobawadi, Maharashtra, India
GYM_PHONE=+91-XXXXXXXXXX
GYM_EMAIL=info@rvfitness.com
GYM_GSTIN=
